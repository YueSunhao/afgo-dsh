{
  "name": "afgo-dsh",
  "version": "1.6.0",
  "description": "面向 DeepSeek Harness（DSH）的 AsterFire Go 科学智算插件，提供可视化工作台与 Agent Skill，支持工具检索、任务时间线、Mol* 结构预览、结果图片与数值图、工作流调用及产物获取。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "asterfire",
    "asterfire-go",
    "afgo",
    "星使智算",
    "科学计算",
    "科学智算",
    "蛋白质设计",
    "蛋白结构预测",
    "蛋白质工程",
    "分子动力学",
    "分子模拟",
    "分子对接",
    "自由能计算",
    "生物信息学",
    "结构生物信息学",
    "DFT计算",
    "密度泛函",
    "量子化学",
    "第一性原理",
    "电子结构",
    "高通量计算",
    "材料计算",
    "云计算",
    "科研自动化",
    "science-computing",
    "scientific-computing",
    "computational-chemistry",
    "quantum-chemistry",
    "density-functional-theory",
    "molecular-dynamics",
    "protein-design",
    "protein-structure-prediction",
    "docking",
    "bioinformatics",
    "materials-science",
    "hpc",
    "workflow"
  ],
  "type": "module",
  "scripts": {
    "build:viewer": "node scripts/build-viewer.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "viewer",
    "docs",
    "scripts",
    "reference",
    "examples",
    "SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "engines": {
      "dsh": ">=0.1.7"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "molstar": "5.13.1"
  },
  "dependencies": {
    "playwright-core": "1.65.0"
  }
}
